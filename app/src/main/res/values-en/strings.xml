    <string name="about_update_latest_msg">Huiguang %1$s (Build %2$d) is currently installed.\n\nThis build does not connect to an update server automatically; please check the release page for newer versions.</string>
    <string name="about_github_dialog_msg">Huiguang is open-sourced under Apache-2.0 on GitHub (silorny/Huiguang-Pixiv).\n\nYou can open the project repository in your browser or copy its URL.</string>
