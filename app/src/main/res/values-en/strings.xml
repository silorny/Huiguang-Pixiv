    <string name="license_view_bsd_text">View Skia BSD-3-Clause text</string>
    <string name="license_view_coui_notice">View COUI-Kit NOTICE text</string>
    <string name="about_ack_intro">Heartfelt thanks to the open-source projects, creators, and communities behind Huiguang:</string>
    <string name="about_ack_coui_title">COUI-Kit (ItosEO)</string>
    <string name="about_ack_coui_body">For providing a faithful native Compose UI kit, material renderer, and design baseline that brings smooth fluid interactions to life.</string>
    <string name="about_ack_pixiv_title">Pixiv Creators &amp; Community</string>
    <string name="about_ack_pixiv_body">For continuously creating inspiring illustrations, manga, and novels that enrich the community worldwide.</string>
    <string name="about_ack_oss_title">Open-Source Ecosystem</string>
    <string name="about_ack_oss_body">For Kotlin, Android Jetpack Compose, OkHttp, Coil, and the maintainers supporting the modern Android ecosystem.</string>
    <string name="about_ack_testers_title">Testers &amp; Contributors</string>
    <string name="about_ack_testers_body">For everyone who tested on real devices and shared feedback to help polish every detail.</string>
